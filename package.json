    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
