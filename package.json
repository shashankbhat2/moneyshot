{
  "name": "moneyshot",
  "private": true,
  "description": "Open source screenshot editor: backgrounds, frames and sizes for every platform.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
